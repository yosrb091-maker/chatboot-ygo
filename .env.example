# Copiez ce fichier vers .env, puis remplacez YOUR_API_KEY par votre clé Google AI Studio.
GEMINI_API_KEY=YOUR_API_KEY

# Vous pouvez choisir un autre modèle Gemini compatible avec votre clé.
GEMINI_MODEL=gemini-3.5-flash-lite

# Utilisé par la vérification de santé de la plateforme, pas pour stocker les conversations.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
